      margin: 20px auto;
      max-width: 600px;
    }
    button {
      background: #333;
      color: #fff;
      border: none;
      padding: 15px 30px;
      font-size: 1.2em;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 20px;
    }
    #contador {
